# Finsible Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ==============================================
# Database Configuration
# ==============================================

# PostgreSQL connection URL
# Format: jdbc:postgresql://host:port/database
DB_URL=jdbc:postgresql://localhost:5432/finsible_db

# Database username
DB_USERNAME=your_db_username

# Database password
DB_PASSWORD=your_db_password

# ==============================================
# JWT Configuration
# ==============================================

# JWT signing secret key
# IMPORTANT: Use a strong, random key (minimum 32 characters)
# Generate with: openssl rand -base64 32
SECRET_KEY=your-very-secure-secret-key-minimum-32-characters

# JWT token expiration in milliseconds
# Examples:
#   1 hour = 3600000
#   24 hours = 86400000
#   7 days = 604800000
JWT_EXPIRATION=86400000

# ==============================================
# Google OAuth Configuration
# ==============================================

# Google OAuth client secret from Google Cloud Console
# Get from: https://console.cloud.google.com/apis/credentials
REACT_WEB_APP_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================
# Admin Configuration (Optional)
# ==============================================

# Default admin email address
# This user will have admin privileges
ADMIN_EMAIL=admin@example.com

# ==============================================
# Spring Profile (Optional)
# ==============================================

# Active Spring profile (dev, prod)
# Default: dev
# SPRING_PROFILES_ACTIVE=dev
